{
  "name": "cc-c",
  "version": "1.5.0",
  "description": "Claude Code Container — launch a containerized claude session from any project directory via docker compose",
  "keywords": [
    "claude-code",
    "claude",
    "docker",
    "container",
    "cli"
  ],
  "license": "MIT",
  "author": "leiyi.jp",
  "bin": {
    "cc-c": "dist/cli.js"
  },
  "files": [
    "dist",
    "compose.yml",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
