# Single source of truth for the release version.
#
# Consumed by:
#   - npm/compose.yml        -> image tag  jiangsier/ccc:${CCC_VERSION}
#   - build.sh               -> docker tag jiangsier/ccc:${CCC_VERSION}
#   - scripts/publish-npm.sh -> npm version ${CCC_VERSION}.0
#
# Bump this one value, then run ./build.sh (pushes the image) BEFORE
# scripts/publish-npm.sh (publishes the CLI that points at it).
#
# NOTE: tracked in git on purpose — .gitignore has a `!npm/.env` negation.
# It must ship inside the npm tarball (see the `files` field in package.json),
# otherwise installed `cc-c` users would fall back to the hardcoded default.
CCC_VERSION=1.6
